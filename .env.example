# AXVYRA Environment Variables

# Neon Serverless PostgreSQL Connection String
# Get this from your Neon Console (https://neon.tech) or Vercel Postgres Integration
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/axvyra_db?sslmode=require"

# Next.js App URL (Set automatically on Vercel)
NEXT_PUBLIC_APP_URL="https://axvyra.vercel.app"

# Application Environment
NODE_ENV="production"
